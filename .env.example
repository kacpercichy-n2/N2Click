# Skopiuj ten plik do .env.local i uzupełnij wartości ze swojego projektu Supabase.
# .env.local jest ignorowany przez git — nie commituj prawdziwych wartości.
# Używaj wyłącznie klucza publishable (sb_publishable_...), nigdy sekretnego.
VITE_SUPABASE_URL=https://twoj-projekt.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_twoj_klucz

# Dysk Google w module Content Plan (wybór mediów przez Google Picker).
# Obie wartości bierzesz z Google Cloud dla projektu N2:
#  - VITE_GOOGLE_CLIENT_ID: klient OAuth typu „Web application" o nazwie
#    „N2 Content Planner Web" (Credentials > OAuth 2.0 Client IDs). Adres
#    aplikacji musi być na liście Authorized JavaScript origins.
#  - VITE_GOOGLE_API_KEY: klucz API z tego samego projektu, ograniczony do
#    Google Picker API (Credentials > API keys).
# Bez tych zmiennych moduł Content Plan działa normalnie, wyłączone są tylko
# przyciski wyboru plików i folderu z Dysku (przycisk pokazuje powód blokady).
VITE_GOOGLE_CLIENT_ID=123456789012-przykladowy.apps.googleusercontent.com
VITE_GOOGLE_API_KEY=twoj_klucz_api_google
